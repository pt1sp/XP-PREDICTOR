generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id           Int      @id @default(autoincrement())
  playedAt     DateTime
  rule         String
  stage1       String
  stage2       String
  weapon       String
  wins         Int
  losses       Int
  fatigue      Int      // 1-5
  irritability Int      // 1-5
  concentration Int     // 1-5
  startXp      Int
  endXp        Int
  memo         String?
  createdAt    DateTime @default(now())
}

model Match {
  id         Int      @id @default(autoincrement())
  externalId String   @unique @map("external_id")
  playedAt   DateTime @map("played_at")
  mode       String
  rule       String
  stage      String
  weapon     String
  result     String
  rawJson    String   @map("raw_json")
  importedAt DateTime @default(now()) @map("imported_at")
  userId     Int?     @map("user_id")

  @@index([playedAt(sort: Desc)], map: "matches_played_at_idx")
  @@map("matches")
}
